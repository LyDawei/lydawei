---
import BaseLayout from './BaseLayout.astro';
const { title = "About - David Ly", description = "About David Ly - Senior Full-Stack Developer with 11+ years of experience in consulting, biotech, fintech, and web development." } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="about-content">
    <slot />
  </div>
</BaseLayout>

<style>
  .about-content {
    max-width: 800px;
  }
  
  .about-content h1 {
    color: #ffffff;
    margin-bottom: 2rem;
    font-size: 2.5rem;
  }
  
  @media (max-width: 768px) {
    .about-content h1 {
      font-size: 2rem;
    }
  }
</style>
