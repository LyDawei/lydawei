---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate,
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://lydawei.com"
  },
  "url": `https://lydawei.com/blog/${post.slug}`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://lydawei.com/blog/${post.slug}`
  }
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  author={post.data.author}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="blog-post">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.pubDate}>
          {new Date(post.data.pubDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span class="post-author">by {post.data.author}</span>
      </div>
      <div class="post-tags">
        {post.data.tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">← Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 800px;
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #404040;
  }

  .post-title {
    font-size: 2.5rem;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.2;
    background: linear-gradient(45deg, #64b5f6, #90caf9);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    color: #808080;
    font-size: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .post-meta time {
    color: #64b5f6;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: #2d2d2d;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    color: #90caf9;
    border: 1px solid #404040;
  }

  .post-content {
    color: #d0d0d0;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .post-content :global(h1) {
    font-size: 2rem;
    border-bottom: 2px solid #64b5f6;
    padding-bottom: 0.5rem;
  }

  .post-content :global(h2) {
    font-size: 1.6rem;
    color: #64b5f6;
  }

  .post-content :global(h3) {
    font-size: 1.3rem;
    color: #90caf9;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(a) {
    color: #64b5f6;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .post-content :global(a:hover) {
    color: #90caf9;
    border-bottom-color: #90caf9;
  }

  .post-content :global(code) {
    background: #2d2d2d;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
    color: #f1fa8c;
  }

  .post-content :global(pre) {
    background: #2d2d2d;
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid #404040;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid #64b5f6;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: #b0b0b0;
    font-style: italic;
  }

  .post-content :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #404040;
  }

  .back-link {
    color: #64b5f6;
    text-decoration: none;
    font-size: 1.1rem;
    transition: color 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .back-link:hover {
    color: #90caf9;
  }

  @media (max-width: 768px) {
    .blog-post {
      max-width: 100%;
      padding: 0 0.5rem;
    }

    .post-title {
      font-size: 1.8rem;
    }

    .post-content {
      font-size: 1rem;
    }

    .post-content :global(h1) {
      font-size: 1.6rem;
    }

    .post-content :global(h2) {
      font-size: 1.4rem;
    }

    .post-content :global(h3) {
      font-size: 1.2rem;
    }

    .post-content :global(pre) {
      padding: 1rem;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .post-title {
      font-size: 1.5rem;
    }

    .post-meta {
      font-size: 0.9rem;
    }

    .post-content {
      font-size: 0.95rem;
    }
  }
</style>
