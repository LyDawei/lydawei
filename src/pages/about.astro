---
import AboutLayout from "../layouts/AboutLayout.astro"
---

<AboutLayout title="About David Ly">
  <div class="about-content">
    
    <section class="intro-section animated-section">
      <h2 class="section-title">My Story</h2>
      <div class="intro-card">
        <p>I'm David Ly — a senior full-stack developer who builds pragmatic systems designed to last. I focus on clarity, maintainability, and writing code that actually works when it matters.</p>
        <div class="card-shine"></div>
      </div>
    </section>

    <section class="story-grid animated-section">
      <div class="story-card card-1">
        <h3>The Journey</h3>
        <p>With over a decade of experience across mobile, web, and game development, I care more about shipping thoughtful solutions than chasing clever abstractions.</p>
        <div class="item-glow"></div>
      </div>

      <div class="story-card card-2">
        <h3>Leading the Way</h3>
        <p>You might've seen the handle <span class="highlight">Lydawei</span> floating around. It's more than just a username — it's my Chinese name (李大衛), and also a quiet play on the phrase "lead the way." That's who I aspire to be: someone who leads thoughtfully.</p>
        <div class="item-glow"></div>
      </div>

      <div class="story-card card-3">
        <h3>Real Engineering</h3>
        <p>I don't do traditional whiteboard interviews — not because I can't, but because I believe strong engineering is best demonstrated through real code, sound decisions, and collaborative problem-solving.</p>
        <div class="item-glow"></div>
      </div>

      <div class="story-card card-4">
        <h3>Beyond Code</h3>
        <p>Outside of work, I'm raising two kids, developing a psychological platformer in Godot, and exploring storytelling through art and memory.</p>
        <div class="item-glow"></div>
      </div>
    </section>

    <!-- Tech stack tags -->
    <section class="skills-section animated-section">
      <h2 class="section-title">What I Tinker With</h2>
      <div class="tech-tags">
        <span class="tech-tag">TypeScript</span>
        <span class="tech-tag">React</span>
        <span class="tech-tag">Node.js</span>
        <span class="tech-tag">Astro</span>
        <span class="tech-tag">Godot</span>
        <span class="tech-tag">Python</span>
        <span class="tech-tag">JavaScript</span>
      </div>
    </section>
  </div>
</AboutLayout>

<style>
  .about-content {
    max-width: 800px;
    position: relative;
    z-index: 2;
  }

  /* Animated Sections */
  .animated-section {
    margin-bottom: 2.5rem;
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  .intro-section {
    animation-delay: 0.1s;
  }

  .story-grid {
    animation-delay: 0.3s;
  }

  .skills-section {
    animation-delay: 0.5s;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .section-title {
    color: #ffffff;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    position: relative;
    background: linear-gradient(45deg, #ffffff, #64b5f6);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 4s ease-in-out infinite;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Intro Card */
  .intro-card {
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    padding: 1.5rem;
    border-radius: 12px;
    border-left: 4px solid #64b5f6;
    color: #e0e0e0;
    position: relative;
    overflow: hidden;
    font-size: 1.1rem;
    line-height: 1.7;
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    border: 1px solid #404040;
    transition: all 0.3s ease;
  }

  .intro-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.4);
    border-color: #64b5f6;
  }

  .intro-card p {
    margin: 0;
  }

  /* Story Grid */
  .story-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  /* Story Cards */
  .story-card {
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    border: 1px solid #404040;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform: translateY(20px);
    opacity: 0;
    animation: slideInUp 0.6s ease-out forwards;
  }

  .card-1 { animation-delay: 0.6s; }
  .card-2 { animation-delay: 0.7s; }
  .card-3 { animation-delay: 0.8s; }
  .card-4 { animation-delay: 0.9s; }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .story-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: #64b5f6;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5), 0 0 20px rgba(100, 181, 246, 0.2);
  }

  .item-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(100, 181, 246, 0.1) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .story-card:hover .item-glow {
    opacity: 1;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.1; }
    50% { transform: scale(1.1); opacity: 0.2; }
  }

  .story-card h3 {
    margin-bottom: 0.8rem;
    color: #64b5f6;
    font-size: 1.1rem;
    transition: color 0.3s ease;
  }

  .story-card:hover h3 {
    color: #90caf9;
  }

  .story-card p {
    color: #c0c0c0;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    transition: color 0.3s ease;
  }

  .story-card:hover p {
    color: #e0e0e0;
  }

  .highlight {
    color: #64b5f6;
    font-weight: 600;
    position: relative;
    animation: glow 2s ease-in-out infinite alternate;
  }

  @keyframes glow {
    from { text-shadow: 0 0 5px rgba(100, 181, 246, 0.5); }
    to { text-shadow: 0 0 10px rgba(100, 181, 246, 0.8); }
  }

  .card-shine {
    position: absolute;
    top: -50%;
    left: -100%;
    width: 50%;
    height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: rotate(35deg);
    transition: left 0.6s ease;
  }

  .intro-card:hover .card-shine {
    left: 100%;
  }

  /* Skills Section */
  .skills-section {
    text-align: center;
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid #404040;
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .skills-section:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.4);
    border-color: #64b5f6;
  }

  .skills-section::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(100, 181, 246, 0.05) 0%, transparent 70%);
    animation: pulse 4s ease-in-out infinite;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .tech-tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(100, 181, 246, 0.15);
    border: 1px solid rgba(100, 181, 246, 0.4);
    border-radius: 20px;
    color: #64b5f6;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .tech-tag:hover {
    background: rgba(100, 181, 246, 0.25);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(100, 181, 246, 0.4);
  }
  
  @media (max-width: 768px) {
    .about-content {
      padding: 0;
      max-width: 100%;
    }

    .story-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 0.5rem;
    }

    .intro-card, .story-card, .skills-section {
      padding: 1rem;
      margin: 0 0.5rem;
    }

    .section-title {
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }

    .intro-card {
      font-size: 1rem;
      line-height: 1.5;
    }

    .story-card h3 {
      font-size: 1rem;
      margin-bottom: 0.6rem;
    }

    .story-card p {
      font-size: 0.9rem;
      line-height: 1.5;
    }

    /* Skills section mobile optimization */
    .skills-section {
      padding: 1.5rem 1rem;
    }

    .tech-tag {
      font-size: 0.75rem;
      padding: 0.4rem 0.8rem;
    }
  }

  /* Extra small mobile devices */
  @media (max-width: 480px) {
    .about-content {
      padding: 0;
    }

    .intro-card, .story-card, .skills-section {
      margin: 0 0.25rem;
      padding: 0.8rem;
    }

    .section-title {
      font-size: 1.1rem;
    }

    .story-card h3 {
      font-size: 0.95rem;
    }

    .story-card p, .intro-card p {
      font-size: 0.85rem;
    }

    .tech-tag {
      font-size: 0.7rem;
      padding: 0.35rem 0.7rem;
    }
  }
</style>