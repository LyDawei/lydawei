---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="David Ly - Projects">
  <div class="projects-content">
    <h1>Projects</h1>
    <p class="intro">A collection of projects I've been working on, showcasing various technologies and creative ideas.</p>

    <div class="projects-grid">
      <a href="/projects/pokedex" class="project-card">
        <div class="project-header">
          <h2>Pokedex AI</h2>
          <span class="project-status">Active</span>
        </div>
        <p class="project-description">
          An interactive web application that faithfully recreates the classic Nintendo Pokedex device using Svelte 5 and modern web APIs, featuring all 151 Generation I Pokemon with animated sprites, authentic game sounds, and AI-powered text-to-speech narration of Pokedex entries via ElevenLabs.
        </p>
        <div class="tech-stack">
          <span class="tech-tag">Svelte 5</span>
          <span class="tech-tag">SvelteKit</span>
          <span class="tech-tag">TypeScript</span>
          <span class="tech-tag">ElevenLabs AI</span>
          <span class="tech-tag">PokeAPI</span>
        </div>
        <div class="project-footer">
          <span class="view-link">View Project →</span>
        </div>
        <div class="card-glow"></div>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-content {
    max-width: 900px;
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h1 {
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    font-size: 2.5rem;
    background: linear-gradient(45deg, var(--color-text-primary), var(--color-primary));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 4s ease-in-out infinite;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .intro {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
    padding: var(--spacing-lg);
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-primary);
    animation: slideInUp 0.8s ease-out 0.2s both;
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .projects-grid {
    display: grid;
    gap: var(--spacing-xl);
  }

  .project-card {
    display: block;
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    border: 1px solid #404040;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    animation: slideInUp 0.6s ease-out 0.4s both;
  }

  .project-card:hover {
    transform: translateY(-8px) scale(1.01);
    border-color: var(--color-primary);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), 0 0 30px rgba(100, 181, 246, 0.3);
  }

  .card-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(100, 181, 246, 0.1) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .project-card:hover .card-glow {
    opacity: 1;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.1;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.2;
    }
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
  }

  .project-card h2 {
    color: var(--color-primary);
    margin: 0;
    font-size: 1.8rem;
    transition: color 0.3s ease;
  }

  .project-card:hover h2 {
    color: var(--color-primary-light);
  }

  .project-status {
    padding: 0.4rem 0.8rem;
    background: linear-gradient(135deg, rgba(100, 181, 246, 0.2), rgba(100, 181, 246, 0.1));
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .project-description {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--spacing-lg);
    font-size: 1rem;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
  }

  .tech-tag {
    padding: 0.4rem 0.8rem;
    background: linear-gradient(135deg, var(--color-border) 0%, var(--color-bg-medium) 100%);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    transition: all 0.3s ease;
  }

  .project-card:hover .tech-tag {
    background: linear-gradient(135deg, rgba(100, 181, 246, 0.2), rgba(100, 181, 246, 0.1));
    border-color: var(--color-primary);
    color: var(--color-primary-light);
  }

  .project-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .view-link {
    color: var(--color-primary);
    font-weight: 600;
    transition: all 0.3s ease;
    position: relative;
  }

  .view-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-primary-light);
    transition: width 0.3s ease;
  }

  .project-card:hover .view-link {
    color: var(--color-primary-light);
    transform: translateX(4px);
  }

  .project-card:hover .view-link::after {
    width: 100%;
  }

  @media (max-width: 768px) {
    .projects-content {
      max-width: 100%;
    }

    h1 {
      font-size: 1.8rem;
      text-align: center;
    }

    .intro {
      font-size: 1rem;
      padding: var(--spacing-md);
      margin-bottom: 1.5rem;
    }

    .project-card {
      padding: var(--spacing-lg);
      margin: 0 0.25rem;
    }

    .project-card h2 {
      font-size: 1.4rem;
    }

    .project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-sm);
    }

    .project-description {
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .tech-tag {
      font-size: 0.75rem;
      padding: 0.3rem 0.6rem;
    }

    .project-card:hover {
      transform: translateY(-4px) scale(1.01);
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 1.6rem;
    }

    .intro {
      font-size: 0.95rem;
      padding: 0.8rem;
    }

    .project-card {
      padding: var(--spacing-md);
    }

    .project-card h2 {
      font-size: 1.2rem;
    }

    .project-description {
      font-size: 0.9rem;
    }
  }
</style>
