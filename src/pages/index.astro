---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="David Ly - Senior Full-Stack Developer">
  <!-- Floating particles background -->
  <div class="particles-container">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <div class="home-content">
  
    <div class="intro animated-intro">
      <p>Currently crafting web applications, leading development teams, and occasionally writing about the craft.</p>
    </div>

    <section class="current-focus animated-section">
      <h2 class="section-title">What I'm Working On</h2>
      <div class="focus-grid">
        <div class="focus-item item-1">
          <h3>🚀 Building Products</h3>
          <p>Full-stack web applications with React, TypeScript, and modern tooling</p>
          <div class="item-glow"></div>
        </div>
        <div class="focus-item item-2">
          <h3>🎮 Side Quest</h3>
          <p>A psychological platformer game in Godot (because why not?)</p>
          <div class="item-glow"></div>
        </div>
        <div class="focus-item item-3">
          <h3>✍️ Writing</h3>
          <p>Thoughts on development, leadership, and building better software</p>
          <div class="item-glow"></div>
        </div>
      </div>
    </section>

    <section class="quick-links animated-section">
      <h2 class="section-title">Start Here</h2>
      <div class="links-grid">
        <a href="/about" class="link-card card-1">
          <h3>My Story</h3>
          <p>Learn about my journey, philosophy, and what drives me →</p>
          <div class="card-shine"></div>
        </a>
        <a href="/blog" class="link-card card-2">
          <h3>Recent Writing</h3>
          <p>Latest thoughts on code, leadership, and craft →</p>
          <div class="card-shine"></div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Floating Particles */
  .particles-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #64b5f6;
    border-radius: var(--radius-full);
    opacity: 0.4;
  }

  .particle:nth-child(1) {
    left: 20%;
    animation: float 8s ease-in-out infinite;
  }

  .particle:nth-child(2) {
    left: 60%;
    animation: float 10s ease-in-out infinite 2s;
  }

  .particle:nth-child(3) {
    left: 80%;
    animation: float 6s ease-in-out infinite 4s;
  }

  .particle:nth-child(4) {
    left: 40%;
    animation: float 9s ease-in-out infinite 6s;
  }

  /* Float animation for particles - extends base float */
  @keyframes float {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
      opacity: 0.4;
    }
    50% {
      transform: translateY(-100px) rotate(180deg);
      opacity: 0.8;
    }
  }

  .home-content {
    max-width: 800px;
    position: relative;
    z-index: 2;
  }
  
  h1 {
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    font-size: 2.5rem;
  }
  
  /* Animated Intro */
  .animated-intro {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    padding: var(--spacing-lg);
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    border-radius: var(--radius-md);
    border-left: 4px solid #64b5f6;
    color: var(--color-text-secondary);
    position: relative;
    overflow: hidden;
    animation: slideInUp 0.8s ease-out;
  }

  .animated-intro::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(100, 181, 246, 0.1), transparent);
    animation: shimmer 3s ease-in-out infinite;
  }

  /* Shimmer effect for intro card */
  .animated-intro::before {
    animation: shimmer 3s ease-in-out infinite;
  }

  .animated-intro strong {
    color: var(--color-primary);
  }

  /* Animated Sections - staggered entry animations */
  .animated-section {
    margin-bottom: var(--spacing-2xl);
    animation: fadeInUp var(--duration-slow) ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  .current-focus {
    animation-delay: calc(var(--animation-delay-base) * 2); /* 0.2s */
  }

  .quick-links {
    animation-delay: calc(var(--animation-delay-base) * 4); /* 0.4s */
  }

  .section-title {
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-md);
    font-size: 1.5rem;
    position: relative;
    background: linear-gradient(45deg, var(--color-text-primary), var(--color-primary));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 4s ease-in-out infinite;
  }
  
  .focus-grid, .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-lg);
    margin-top: 1rem;
  }
  
  /* Enhanced Focus Items */
  .focus-item {
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    padding: var(--spacing-lg);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    border: 1px solid #404040;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform: translateY(20px);
    opacity: 0;
    animation: slideInUp 0.6s ease-out forwards;
  }

  /* Staggered focus item animations */
  .item-1 { animation-delay: calc(var(--animation-delay-base) * 5); } /* 0.5s */
  .item-2 { animation-delay: calc(var(--animation-delay-base) * 6); } /* 0.6s */
  .item-3 { animation-delay: calc(var(--animation-delay-base) * 7); } /* 0.7s */

  /* Focus item hover - subtle lift with glow effect */
  .focus-item:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-xl), 0 0 20px rgba(100, 181, 246, 0.2);
  }

  /* Ambient glow for interactive cards */
  .item-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(100, 181, 246, 0.1) 0%, transparent 70%);
    opacity: 0;
    transition: opacity var(--duration-fast) ease;
    pointer-events: none;
  }

  .focus-item:hover .item-glow {
    opacity: 1;
    animation: pulse 2s ease-in-out infinite;
  }
  
  .focus-item h3 {
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-primary);
    font-size: 1.1rem;
    transition: color 0.3s ease;
  }

  .focus-item:hover h3 {
    color: var(--color-primary-light);
  }
  
  .focus-item p {
    color: var(--color-text-dim);
    font-size: 0.95rem;
    margin: 0;
    transition: color 0.3s ease;
  }

  .focus-item:hover p {
    color: var(--color-text-dim);
  }
  
  /* Enhanced Link Cards */
  .link-card {
    display: block;
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    padding: var(--spacing-lg);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    border: 1px solid #404040;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform: translateY(20px);
    opacity: 0;
    animation: slideInUp 0.6s ease-out forwards;
  }

  /* Staggered link card animations */
  .card-1 { animation-delay: calc(var(--animation-delay-base) * 8); } /* 0.8s */
  .card-2 { animation-delay: calc(var(--animation-delay-base) * 9); } /* 0.9s */

  /* Link card hover - pronounced lift effect */
  .link-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-xl), 0 0 20px rgba(100, 181, 246, 0.3);
    border-color: var(--color-primary);
  }

  /* Shine effect that sweeps across on hover */
  .card-shine {
    position: absolute;
    top: -50%;
    left: -100%;
    width: 50%;
    height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: rotate(35deg);
    transition: left var(--duration-normal) ease;
  }

  .link-card:hover .card-shine {
    left: 100%;
  }
  
  .link-card h3 {
    margin-bottom: var(--spacing-sm);
    color: var(--color-primary);
    font-size: 1.1rem;
    transition: color 0.3s ease;
  }

  .link-card:hover h3 {
    color: var(--color-primary-light);
  }
  
  .link-card p {
    color: var(--color-text-dim);
    font-size: 0.95rem;
    margin: 0;
    transition: color 0.3s ease;
  }

  .link-card:hover p {
    color: var(--color-text-dim);
  }
  
  a {
    color: var(--color-primary);
    font-weight: 500;
  }
  
  a:hover {
    color: var(--color-primary-light);
    text-decoration: none;
  }
  
  @media (max-width: 768px) {
    /* Mobile particle optimization */
    .particle {
      width: 2px;
      height: 2px;
    }

    .particle:nth-child(3) {
      display: none; /* Hide third particle on mobile for performance */
    }

    .home-content {
      max-width: 100%;
      padding: 0 0.5rem;
    }

    h1 {
      font-size: 1.8rem;
      text-align: center;
    }
    
    .animated-intro {
      font-size: 1rem;
      padding: var(--spacing-md);
      margin: 0 0.25rem 1.5rem;
      border-radius: var(--radius-sm);
    }

    .section-title {
      font-size: 1.2rem;
      text-align: center;
      margin-bottom: 1rem;
    }
    
    .focus-grid, .links-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .focus-item, .link-card {
      margin: 0 0.25rem;
      padding: var(--spacing-md);
      border-radius: var(--radius-sm);
    }

    .focus-item h3, .link-card h3 {
      font-size: 1rem;
    }

    .focus-item p, .link-card p {
      font-size: 0.9rem;
      line-height: 1.5;
    }

    /* Reduce animation intensity on mobile */
    .focus-item:hover, .link-card:hover {
      transform: translateY(-4px) scale(1.01);
    }
  }

  /* Extra small mobile devices */
  @media (max-width: 480px) {
    .particle {
      display: none; /* Hide particles on very small screens for performance */
    }

    .home-content {
      padding: 0 0.25rem;
    }

    h1 {
      font-size: 1.6rem;
    }

    .animated-intro {
      font-size: 0.95rem;
      padding: 0.8rem;
      margin-bottom: 1.2rem;
    }

    .section-title {
      font-size: 1.1rem;
    }

    .focus-item, .link-card {
      padding: 0.8rem;
    }

    .focus-item h3, .link-card h3 {
      font-size: 0.95rem;
    }

    .focus-item p, .link-card p {
      font-size: 0.85rem;
    }

    /* Disable hover effects on touch devices */
    .focus-item:hover, .link-card:hover {
      transform: none;
      box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    }
  }
</style>